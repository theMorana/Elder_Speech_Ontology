ex:LanguageVariant a owl:Class .

ex:appearsIn a owl:ObjectProperty ;
    rdfs:domain ex:LexicalUnit ;
    rdfs:range ex:Source .

ex:derivedFrom a owl:ObjectProperty ;
    rdfs:domain ex:LexicalUnit ;
    rdfs:range ex:NaturalLanguage .

ex:hasConfidence a owl:DatatypeProperty ;
    rdfs:domain ex:LexicalUnit ;
    rdfs:range xsd:string .

ex:hasCorrespondingForm a owl:DatatypeProperty ;
    rdfs:domain ex:LexicalUnit ;
    rdfs:range xsd:string .

ex:hasLexicalUnit a owl:ObjectProperty ;
    rdfs:domain ex:FictionalLanguage ;
    rdfs:range ex:LexicalUnit .

ex:hasMeaning a owl:ObjectProperty ;
    rdfs:domain ex:LexicalUnit ;
    rdfs:range ex:Meaning .

ex:hasReferenceNote a owl:DatatypeProperty ;
    rdfs:domain ex:LexicalUnit ;
    rdfs:range xsd:string .

ex:hasVariant a owl:ObjectProperty ;
    rdfs:domain ex:LexicalUnit ;
    rdfs:range ex:LexicalVariant .

ex:influencedBy a owl:ObjectProperty ;
    rdfs:domain ex:LexicalUnit ;
    rdfs:range ex:NaturalLanguage .

ex:LexicalVariant a owl:Class .

ex:lang_English a ex:NaturalLanguage ;
    rdfs:label "English"@en .

ex:lang_Romanian a ex:NaturalLanguage ;
    rdfs:label "Romanian"@en .

